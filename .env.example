# Email Configuration for Nodemailer
# Setup your email settings here

# Email Host (SMTP Server)
EMAIL_HOST=mail.ultracomnetworks.pk
# or use: smtp.gmail.com (for Gmail)
# or use: smtp-mail.outlook.com (for Outlook)

# Email Port
EMAIL_PORT=587
# Use 587 for TLS
# Use 465 for SSL

# Email User (Sender Email Address)
EMAIL_USER=sales@ultracomnetworks.pk
# This should be your actual company email

# Email Password (App Password or SMTP Password)
EMAIL_PASS=your_email_password_here
# For Gmail: Use App Password (not regular password)
# For Outlook: Use SMTP password
# For cPanel: Use your cPanel email password

# Optional: Support Email
SUPPORT_EMAIL=support@ultracomnetworks.pk

# Optional: Technical Support Email
TECH_EMAIL=tech@ultracomnetworks.pk

# Google Gemini API key for the AI chat widget and contact-form automation
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Sanity CMS (powers the admin panel at /studio) - create a free project at sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# WhatsApp confirmation messages (Meta WhatsApp Cloud API)
# Set up at https://developers.facebook.com/apps -> add the WhatsApp product
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=form_confirmation
WHATSAPP_TEMPLATE_LANG=en

# Resend - reliable transactional email for serverless (replaces cPanel SMTP,
# which blocks/times out connections from Vercel's IPs). Sign up free at resend.com,
# verify your sending domain, then set these.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
